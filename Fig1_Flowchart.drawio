        <!-- ========== MAIN BOXES (vertical flow) ========== -->

        <!-- Box 1: MIMIC-IV Database -->
        <mxCell id="box1" value="&lt;b&gt;MIMIC-IV v3.1 Database&lt;/b&gt;&lt;br&gt;N = 546,028 hospital admissions&lt;br&gt;(2008&amp;#8211;2022)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1">
